# =============================================================================
# CIP — CAPTADOR INTELIGENTE DE PROPIEDADES (GOLDEN STARTER V2)
# Environment Variables Specification
# =============================================================================

# 1. Base de Datos (PostgreSQL 18 + Drizzle ORM)
DATABASE_URL=postgresql://starter_dev:starter_pass@localhost:5432/starter_db
POSTGRES_USER=starter_dev
POSTGRES_PASSWORD=starter_pass
POSTGRES_DB=starter_db

# 2. Autenticación (Better Auth)
BETTER_AUTH_SECRET=dev_super_secret_auth_key_at_least_32_characters_long!
BETTER_AUTH_URL=http://localhost:3000

# 3. Microservicio Interno de IA (Flask + Celery BFF)
# En Docker Compose interno: http://flask-api:5000; en host local: http://localhost:5000
FLASK_API_URL=http://localhost:5000
AI_SATELLITE_URL=http://localhost:5000
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# 4. Almacenamiento AWS S3 (Buckets Privados para Fotos y Audios Crudos)
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=mock_aws_access_key_id
AWS_SECRET_ACCESS_KEY=mock_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=starter-media-bucket
S3_BUCKET=starter-media-bucket
LOCAL_STORAGE_DIR=storage/uploads

# 5. Modelos de IA en la Nube (Restricción estricta: SDKs en la nube, prohibido Ollama)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# 6. Entorno de Ejecución
NODE_ENV=development
PORT=3000
