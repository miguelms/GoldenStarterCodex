# =============================================================================
# GS Vera Clinic — Plantilla de Variables de Entorno (Ejemplo / Desarrollo)
# =============================================================================

# Entorno de ejecución y servidor
NODE_ENV=development
PORT=3005
APP_NAME="GS Vera Clinic"

# Conexión a Base de Datos PostgreSQL
POSTGRES_URL=postgres://careflow:careflow@localhost:55432/careflow
DATABASE_URL=postgres://careflow:careflow@localhost:55432/careflow

# Configuración de Autenticación (Better Auth)
BETTER_AUTH_SECRET=replace-with-a-local-random-secret-minimum-32-chars
BETTER_AUTH_URL=http://localhost:3005

# Configuración pública de Frontend / API
NEXT_PUBLIC_API_URL=http://localhost:3005
NEXT_PUBLIC_APP_NAME="GS Vera Clinic"
NEXT_PUBLIC_GEOFENCE_RADIUS_METERS=75
