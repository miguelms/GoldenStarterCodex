{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "run_id",
    "agent_id",
    "evaluated_ref",
    "status",
    "verdict",
    "summary",
    "files_changed",
    "deliverables",
    "checks",
    "blockers",
    "next_action"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "evaluated_ref": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["COMPLETED", "FAILED", "BLOCKED"]
    },
    "verdict": {
      "enum": ["APPROVED", "REJECTED", "BLOCKED", "NOT_APPLICABLE"]
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required", "status", "method", "exit_code", "artifact", "reason"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "enum": ["PASS", "FAIL", "NOT_RUN", "NOT_APPLICABLE"]
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": ["integer", "null"]
          },
          "artifact": {
            "type": ["string", "null"]
          },
          "reason": {
            "type": ["string", "null"]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              }
            },
            "then": {
              "properties": {
                "artifact": {
                  "type": "string",
                  "minLength": 1
                },
                "exit_code": {
                  "enum": [0, null]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "NOT_APPLICABLE"
                }
              }
            },
            "then": {
              "properties": {
                "required": {
                  "const": false
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "APPROVED"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "COMPLETED"
          },
          "blockers": {
            "maxItems": 0
          },
          "checks": {
            "minItems": 1,
            "items": {
              "if": {
                "properties": {
                  "required": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "status": {
                    "const": "PASS"
                  }
                }
              }
            },
            "contains": {
              "type": "object",
              "properties": {
                "status": {
                  "const": "PASS"
                }
              },
              "required": ["status"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "BLOCKED"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "BLOCKED"
          },
          "blockers": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
